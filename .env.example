# Copy to .env and fill in once the Supabase project exists.
# Without these the site still works: projects come from src/data/projects.ts
# and the contact form opens a prefilled email.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only for scripts/sync-github.mjs (never shipped to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
